<div class="author">
  <h1 class="author__heading">Hi, I am godoflevel.</h1>
  <p class="author__body">Web developer and server creator</p>
</div>

<img src="/images/avatar.png" alt="godoflevel avatar" class="hero-image" width="981" height="528"></img>

<section class="articles">
  <h2 class="articles__heading">Latest Posts
    <ul class="article-ul">

      <% data.forEach(post => { %>

      <li>
        <a href="/post/<%= post._id %>">
          <span><%= post.title %></span>
          <span class="article-list__date"><%= post.createdAt.toDateString() %></span>
        </a>
      </li>
      <% }) %>
    </ul>
  </h2>

  <% if (nextPage !== null) { %>
  <a href="/?page=<%= nextPage  %>" class="pagination"> &lt; View Older Posts</a>
  <% } %>
</section>